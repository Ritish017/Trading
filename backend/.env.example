# APEX Personal AI Quant & Trading Lab Environment Variables
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Provider Selection: UPSTOX, FYERS, DHAN, MOCK
ACTIVE_BROKER_PROVIDER=UPSTOX

# Strict Mode Flag: Set to true only if you want automatic fallback to synthetic mock prices on live connection failure
ALLOW_MOCK_FALLBACK=false

# ==================================================
# UPSTOX REAL MARKET DATA CONFIGURATION
# ==================================================
UPSTOX_ENABLED=true
# Place your Upstox Analytics Token generated from Upstox Developer Dashboard below
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_WS_ENABLED=true
UPSTOX_PROVIDER_PRIORITY=upstox

# Optional Gemini AI API Key
GEMINI_API_KEY=

# Database Configuration (Defaults to in-memory SQLite if unset)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/apextrading
