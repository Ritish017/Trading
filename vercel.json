{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.py": {
      "includeFiles": "{docs/**,backend/**}",
      "excludeFiles": "{frontend/**,scripts/**,.agents/**,backend/tests/**,logs/**,*.db,*.png}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
